generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String           @id @default(cuid())
  name                 String?
  email                String           @unique
  emailVerified        DateTime?
  image                String?
  createdAt            DateTime         @default(now())
  stripeTestCustomerId String?          @unique
  stripeLiveCustomerId String?          @unique
  accounts             Account[]
  billingProfile       BillingProfile?
  builderLessons       BuilderLesson[]
  customLinks          CustomLink[]
  LessonProgress       LessonProgress[]
  payments             Payment[]
  sessions             Session[]
  subscriptions        Subscription[]
  gameParticipants     GameParticipant[]
  playerRatings        PlayerRating[]
  pathwayProgress      PathwayProgress?
  assessmentAttempts   AssessmentAttempt[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                    String             @id @default(cuid())
  userId                String
  productId             String
  status                SubscriptionStatus
  gatewaySubscriptionId String?            @unique
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean            @default(false)
  canceledAt            DateTime?
  endedAt               DateTime?
  trialStart            DateTime?
  trialEnd              DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  payments              Payment[]
  product               Product            @relation(fields: [productId], references: [id])
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id                     String        @id @default(cuid())
  userId                 String
  subscriptionId         String?
  amount                 Int
  currency               String        @default("usd")
  status                 PaymentStatus
  paymentMethod          String?
  gatewayPaymentIntentId String?       @unique
  gatewayInvoiceId       String?
  receiptUrl             String?
  errorMessage           String?
  provider               String        @default("stripe")
  failureCode            String?
  gatewayCustomerId      String?
  refundedAmount         Int?          @default(0)
  gatewayMetadata        Json?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  subscription           Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BillingProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  billingEmail String?
  billingName  String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  vatId        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id                 String           @id @default(cuid())
  identifier         String           @unique
  name               String
  description        String?
  priceAmount        Int
  currency           String           @default("usd")
  billingInterval    String
  gatewayTestPriceId String?          @unique
  gatewayLivePriceId String?          @unique
  isActive           Boolean          @default(true)
  displayOrder       Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  features           ProductFeature[]
  subscriptions      Subscription[]
}

model ProductFeature {
  id           String   @id @default(cuid())
  productId    String
  featureKey   String
  featureValue String   @default("true")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, featureKey])
}

model WebhookEvent {
  id             String   @id @default(cuid())
  gatewayEventId String   @unique
  provider       String
  eventType      String
  processed      Boolean  @default(true)
  payload        Json?
  createdAt      DateTime @default(now())
}

model CuratedPuzzle {
  id              String   @id
  fen             String
  moves           String
  rating          Int
  ratingDeviation Int
  popularity      Int
  nbPlays         Int
  themes          String[] @default([])
  createdAt       DateTime @default(now())

  @@index([rating])
}

model Opening {
  id    String @id @default(cuid())
  eco   String
  name  String
  pgn   String
  moves String

  @@index([eco])
  @@index([name])
}

enum BuilderLessonStatus {
  DRAFT
  PUBLISHED
}

model BuilderLesson {
  id                String              @id @default(cuid())
  title             String
  description       String?
  authorId          String
  author            User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorDisplayName String?
  status            BuilderLessonStatus @default(DRAFT)
  category          String?
  coverImage        String?
  slug              String?             @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  publishedAt       DateTime?

  segments BuilderSegment[]

  @@index([authorId])
  @@index([status])
  @@index([slug])
}

model BuilderSegment {
  id          String        @id @default(cuid())
  lessonId    String
  lesson      BuilderLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title       String
  order       Int
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  slides BuilderSlide[]

  @@unique([lessonId, order])
  @@index([lessonId])
}

model BuilderSlide {
  id          String         @id @default(cuid())
  segmentId   String
  segment     BuilderSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  order       Int
  title       String?
  coachText   String         @db.Text
  fen         String
  annotations Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([segmentId, order])
  @@index([segmentId])
}

model Course {
  id          String   @id
  slug        String   @unique
  title       String
  description String?
  thumbnail   String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  Lesson      Lesson[]
}

model Lesson {
  id             String           @id
  courseId       String
  slug           String           @unique
  title          String
  description    String?
  thumbnail      String?
  difficulty     String?
  estimatedTime  Int              @default(0)
  category       String?
  published      Boolean          @default(false)
  content        Json
  settings       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  Course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  LessonProgress LessonProgress[]
}

model LessonProgress {
  id          String   @id
  userId      String
  lessonId    String
  currentStep Int      @default(0)
  completed   Boolean  @default(false)
  accuracy    Float?
  mistakes    Int      @default(0)
  xp          Int      @default(0)
  timeSpent   Int      @default(0)
  updatedAt   DateTime
  Lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

model CustomLink {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  url           String
  isArchived    Boolean   @default(false)
  clickCount    Int       @default(0)
  lastClickedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}


// ─────────────────────────────────────────────────────────────────────────
// M4 — Results & Rating
//
// Persists the terminal GameResult that SessionManager emits (see
// backend/src/contracts/result.ts). Purely additive: no existing model is
// changed beyond the two new back-relations on User above.
//
// GameRecord is named deliberately (not "GameSession") to avoid colliding
// with the in-memory, never-persisted GameSession type in
// backend/src/session/types.ts — see m4_implementation_plan.md §1.10.
// ─────────────────────────────────────────────────────────────────────────

model GameRecord {
  id                String                @id @default(cuid())
  gameSessionId     String                @unique
  matchId           String                @unique
  variantId         String
  rated             Boolean
  provenance        MatchProvenance
  outcomeKind       GameOutcomeKind
  winningSide       Int?
  terminationReason GameTerminationReason
  moveCount         Int
  moveHistory       Json?
  initialSeconds    Int?
  incrementSeconds  Int?
  timeControlLabel  String?
  ratingPoolId      String?
  tournamentContext Json?
  metadata          Json?
  durationSeconds   Int?
  endedAt           DateTime
  createdAt         DateTime              @default(now())
  participants      GameParticipant[]
  analysis          GameAnalysis?

  @@index([endedAt])
  @@index([variantId])
}

/// Cached engine analysis of one finished game.
///
/// Stores raw engine output only — evaluations and best moves, never derived
/// classifications. Classification depends on PolicyRegistry values the Feedback
/// module is expected to change; storing it would mean re-running Stockfish over
/// the whole history on every policy edit, instead of a re-aggregation.
///
/// Written post-game; read by multi-game suspect review, which never runs the
/// engine itself. See backend/src/anticheat/MULTI_GAME_REVIEW_REQUIREMENTS.md §11.2.
model GameAnalysis {
  id             String   @id @default(cuid())
  gameRecordId   String   @unique
  /// Engine build and search settings, so a review never mixes evaluations
  /// produced under different conditions into one comparison.
  engineName     String
  engineDepth    Int
  multiPvLines   Int      @default(1)
  startingFen    String
  plyCount       Int
  /// Per ply: ply, side, san, uci, evalBeforeCp, evalAfterCp, bestMove, legalMoveCount.
  plies          Json
  /// Bumped when the plies payload shape changes, so stale rows are re-analysed
  /// rather than silently misread.
  payloadVersion Int      @default(1)
  analysedAt     DateTime @default(now())

  gameRecord     GameRecord @relation(fields: [gameRecordId], references: [id], onDelete: Cascade)

  @@index([analysedAt])
}

model GameParticipant {
  id           String                @id @default(cuid())
  gameRecordId String
  userId       String
  side         Int
  result       GameParticipantResult
  ratingBefore Int?
  ratingAfter  Int?
  ratingDelta  Int?
  gameRecord   GameRecord            @relation(fields: [gameRecordId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameRecordId, userId])
  @@index([userId])
  @@index([userId, result])
}

model PlayerRating {
  id          String   @id @default(cuid())
  userId      String
  variantId   String
  rating      Int      @default(1200)
  gamesPlayed Int      @default(0)
  version     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@index([variantId, rating])
}

enum MatchProvenance {
  queue
  tournament
  invite
  bot
  internal
}

enum GameOutcomeKind {
  win
  draw
}

enum GameParticipantResult {
  WIN
  LOSS
  DRAW
}

enum GameTerminationReason {
  checkmate
  stalemate
  draw_agreement
  draw_repetition
  draw_fifty_move
  draw_insufficient_material
  resignation
  timeout
  forfeit
  abort
}

model PathwayProgress {
  id           String   @id @default(cuid())
  userId       String   @unique
  completedIds String[] @default([])
  streak       Int      @default(0)
  totalSolved  Int      @default(0)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────
// Join Us — Candidate Assessments
//
// AssessmentTemplate holds a frozen, versioned snapshot of a track's full
// question set (pages/questions, shaped exactly like the frontend's
// AssessmentConfig) plus its grading rules. Only one template per trackSlug
// is `isActive` at a time — that's the version new attempts bind to.
// In-progress attempts keep whatever template they started with even after
// a newer version is activated (see AssessmentService.getOrCreateAttempt).
// ─────────────────────────────────────────────────────────────────────────

enum AssessmentAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum AssessmentResult {
  PENDING
  PASS
  FAIL
  REVIEW
}

model AssessmentTemplate {
  id           String              @id @default(cuid())
  trackSlug    String
  version      Int
  isActive     Boolean             @default(true)
  data         Json
  gradingRules Json?
  createdAt    DateTime            @default(now())
  attempts     AssessmentAttempt[]

  @@unique([trackSlug, version])
  @@index([trackSlug, isActive])
}

model AssessmentAttempt {
  id              String                  @id @default(cuid())
  userId          String
  trackSlug       String
  templateId      String
  status          AssessmentAttemptStatus @default(IN_PROGRESS)
  result          AssessmentResult        @default(PENDING)
  lastAccessedAt  DateTime                @default(now())
  answers         Json                    @default("{}")
  radioValues     Json                    @default("{}")
  textValues      Json                    @default("{}")
  bookmarks       Int[]                   @default([])
  estimateMinutes Int?
  timedSectionStartedAt DateTime?
  timedDeadlineAt DateTime?
  extensionUsed   Boolean                 @default(false)
  wrongCount      Int?
  submittedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  template        AssessmentTemplate      @relation(fields: [templateId], references: [id])

  @@unique([userId, trackSlug])
  @@index([trackSlug])
}

// ─────────────────────────────────────────────────────────────────────────
// ADMIN DOMAIN
// ─────────────────────────────────────────────────────────────────────────
// Deliberately isolated from the user-facing User/Account/Session tables: no
// relation here crosses into a UFS model, and no UFS model gains a back-relation.
// An admin is never a player row. Do not add a foreign key between the two sides.
// ─────────────────────────────────────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  VIEWER
}

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model AdminUser {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  avatarUrl   String?
  role        AdminRole @default(ADMIN)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  accounts  AdminAccount[]
  sessions  AdminSession[]
  navItems  AdminUserNavItem[]
  documents AdminDocument[]    @relation("AdminDocumentAuthor")
}

model AdminAccount {
  id                String  @id @default(cuid())
  adminUserId       String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([adminUserId])
}

model AdminSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  adminUserId  String
  expires      DateTime

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

// Required by the Auth.js Adapter interface. Unused by the Google-only flow,
// but its absence leaves the adapter type-incomplete.
model AdminVerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Self-referencing tree. A row with a null `path` is a heading (e.g. "ACS");
// a row with a path is a link. `key` is the stable seed identity — never the label.
model AdminNavItem {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  path        String?
  icon        String?
  parentId    String?
  sortOrder   Int      @default(0)
  isDisabled  Boolean  @default(false)
  isUniversal Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   AdminNavItem?      @relation("AdminNavItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children AdminNavItem[]     @relation("AdminNavItemTree")
  grants   AdminUserNavItem[]

  @@index([parentId, sortOrder])
}

model AdminUserNavItem {
  id          String   @id @default(cuid())
  adminUserId String
  navItemId   String
  createdAt   DateTime @default(now())

  adminUser AdminUser    @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  navItem   AdminNavItem @relation(fields: [navItemId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, navItemId])
  @@index([navItemId])
}

model AdminDocument {
  id          String         @id @default(cuid())
  title       String
  // No @unique: uniqueness must apply to live rows only, or a soft delete would
  // permanently burn the slug. Enforced by the partial unique index
  // "AdminDocument_slug_active_key" (WHERE "deletedAt" IS NULL), which Prisma
  // cannot express — see 20260904120000_add_admin_domain.sql. Do not add @unique.
  slug        String
  description String?
  content     String?
  status      DocumentStatus @default(DRAFT)
  authorId    String?
  // Soft delete. Every read path must filter `deletedAt: null`; the repository
  // is the only layer permitted to touch this column.
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  author AdminUser? @relation("AdminDocumentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([deletedAt, createdAt])
  @@index([status])
  @@index([authorId])
}
