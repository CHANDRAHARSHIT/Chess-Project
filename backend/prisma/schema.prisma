generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String           @id @default(cuid())
  name                 String?
  email                String           @unique
  emailVerified        DateTime?
  image                String?
  createdAt            DateTime         @default(now())
  stripeTestCustomerId String?          @unique
  stripeLiveCustomerId String?          @unique
  accounts             Account[]
  billingProfile       BillingProfile?
  customLinks          CustomLink[]
  LessonProgress       LessonProgress[]
  payments             Payment[]
  sessions             Session[]
  subscriptions        Subscription[]
  gameParticipants     GameParticipant[]
  playerRatings        PlayerRating[]
  pathwayProgress      PathwayProgress?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                    String             @id @default(cuid())
  userId                String
  productId             String
  status                SubscriptionStatus
  gatewaySubscriptionId String?            @unique
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean            @default(false)
  canceledAt            DateTime?
  endedAt               DateTime?
  trialStart            DateTime?
  trialEnd              DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  payments              Payment[]
  product               Product            @relation(fields: [productId], references: [id])
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id                     String        @id @default(cuid())
  userId                 String
  subscriptionId         String?
  amount                 Int
  currency               String        @default("usd")
  status                 PaymentStatus
  paymentMethod          String?
  gatewayPaymentIntentId String?       @unique
  gatewayInvoiceId       String?
  receiptUrl             String?
  errorMessage           String?
  provider               String        @default("stripe")
  failureCode            String?
  gatewayCustomerId      String?
  refundedAmount         Int?          @default(0)
  gatewayMetadata        Json?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  subscription           Subscription? @relation(fields: [subscriptionId], references: [id])
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BillingProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  billingEmail String?
  billingName  String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  vatId        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id                 String           @id @default(cuid())
  identifier         String           @unique
  name               String
  description        String?
  priceAmount        Int
  currency           String           @default("usd")
  billingInterval    String
  isActive           Boolean          @default(true)
  displayOrder       Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  gatewayTestPriceId String?          @unique
  gatewayLivePriceId String?          @unique
  features           ProductFeature[]
  subscriptions      Subscription[]
}

model ProductFeature {
  id           String   @id @default(cuid())
  productId    String
  featureKey   String
  featureValue String   @default("true")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, featureKey])
}

model WebhookEvent {
  id             String   @id @default(cuid())
  gatewayEventId String   @unique
  provider       String
  eventType      String
  processed      Boolean  @default(true)
  payload        Json?
  createdAt      DateTime @default(now())
}

                        
model Opening {
  id    String @id @default(cuid())
  eco   String
  name  String
  pgn   String
  moves String

  @@index([eco])
  @@index([name])
}

model CuratedPuzzle {
  id              String   @id
  fen             String
  moves           String
  rating          Int
  ratingDeviation Int
  popularity      Int
  nbPlays         Int
  themes          String[] @default([])
  createdAt       DateTime @default(now())

  @@index([rating])
}

model Course {
  id          String   @id
  slug        String   @unique
  title       String
  description String?
  thumbnail   String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  Lesson      Lesson[]
}

model Lesson {
  id             String           @id
  courseId       String
  slug           String           @unique
  title          String
  description    String?
  thumbnail      String?
  difficulty     String?
  estimatedTime  Int              @default(0)
  category       String?
  published      Boolean          @default(false)
  content        Json
  settings       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  Course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  LessonProgress LessonProgress[]
}

model LessonProgress {
  id          String   @id
  userId      String
  lessonId    String
  currentStep Int      @default(0)
  completed   Boolean  @default(false)
  accuracy    Float?
  mistakes    Int      @default(0)
  xp          Int      @default(0)
  timeSpent   Int      @default(0)
  updatedAt   DateTime
  Lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

model CustomLink {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  url           String
  isArchived    Boolean   @default(false)
  clickCount    Int       @default(0)
  lastClickedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// ─────────────────────────────────────────────────────────────────────────
// M4 — Results & Rating
//
// Persists the terminal GameResult that SessionManager emits (see
// backend/src/contracts/result.ts). Purely additive: no existing model is
// changed beyond the two new back-relations on User above.
//
// GameRecord is named deliberately (not "GameSession") to avoid colliding
// with the in-memory, never-persisted GameSession type in
// backend/src/session/types.ts — see m4_implementation_plan.md §1.10.
// ─────────────────────────────────────────────────────────────────────────

model GameRecord {
  id                String                @id @default(cuid())
  gameSessionId     String                @unique
  matchId           String                @unique
  variantId         String
  rated             Boolean
  provenance        MatchProvenance
  outcomeKind       GameOutcomeKind
  winningSide       Int?
  terminationReason GameTerminationReason
  moveCount         Int
  moveHistory       Json?
  initialSeconds    Int?
  incrementSeconds  Int?
  timeControlLabel  String?
  ratingPoolId      String?
  tournamentContext Json?
  metadata          Json?
  durationSeconds   Int?
  endedAt           DateTime
  createdAt         DateTime              @default(now())
  participants      GameParticipant[]

  @@index([endedAt])
  @@index([variantId])
}

model GameParticipant {
  id           String                @id @default(cuid())
  gameRecordId String
  userId       String
  side         Int
  result       GameParticipantResult
  ratingBefore Int?
  ratingAfter  Int?
  ratingDelta  Int?
  gameRecord   GameRecord            @relation(fields: [gameRecordId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameRecordId, userId])
  @@index([userId])
  @@index([userId, result])
}

model PlayerRating {
  id          String   @id @default(cuid())
  userId      String
  variantId   String
  rating      Int      @default(1200)
  gamesPlayed Int      @default(0)
  version     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@index([variantId, rating])
}

enum MatchProvenance {
  queue
  tournament
  invite
  bot
  internal
}

enum GameOutcomeKind {
  win
  draw
}

enum GameParticipantResult {
  WIN
  LOSS
  DRAW
}

enum GameTerminationReason {
  checkmate
  stalemate
  draw_agreement
  draw_repetition
  draw_fifty_move
  draw_insufficient_material
  resignation
  timeout
  forfeit
  abort
}

model PathwayProgress {
  id           String   @id @default(cuid())
  userId       String   @unique
  completedIds String[] @default([])
  streak       Int      @default(0)
  totalSolved  Int      @default(0)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}